require('dotenv').config();
const fs = require('fs');
const { Client, LocalAuth } = require('whatsapp-web.js');
const { GoogleGenerativeAI } = require('@google/generative-ai');
const qrcode = require('qrcode-terminal');
const { Client: NotionClient } = require("@notionhq/client");

console.log('🚀 Starting Sylphrena (Silent Mode - 6min Aggregation)...');

const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);
const model = genAI.getGenerativeModel({ model: "gemini-2.5-flash" }); 
const notion = new NotionClient({ auth: process.env.NOTION_TOKEN });

// ניהול זיכרון לצבירת הודעות (Aggregation)
const messageQueues = {}; 
const DEBOUNCE_TIME = 360000; // 360 שניות (6 דקות) של שקט לפני עיבוד

let settings = { authorizedGroups: [] };
if (fs.existsSync('./settings.json')) {
    try {
        settings = JSON.parse(fs.readFileSync('./settings.json'));
    } catch (e) {
        console.error('Error reading settings.json');
    }
}

const whatsapp = new Client({
    authStrategy: new LocalAuth(),
    puppeteer: {
        headless: true,
        args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage', '--disable-gpu']
    }
});

whatsapp.on('qr', qr => {
    console.log('📸 Scan this QR code:');
    qrcode.generate(qr, { small: true });
});

whatsapp.on('ready', () => {
    console.log('🛡️ Sylphrena is bonded and monitoring authorized chats silently.');
});

whatsapp.on('message_create', async (msg) => {
    console.log(`DEBUG: Message from ${msg.from}`);
    if (!settings.authorizedGroups.includes(msg.from)) return;
    if (msg.body && msg.body.startsWith('!')) return;

    const chatId = msg.from;
    const chat = await msg.getChat();
    const chatName = chat.name || "קבוצה ללא שם";
    
    // קבלת הטקסט - גם אם זו תמונה/מסמך עם כיתוב (Caption)
    const content = msg.body || msg.caption || "";
    if (content.length < 2) return;

    // מנגנון צבירה: הוספת ההודעה לתור של הקבוצה
    if (!messageQueues[chatId]) {
        messageQueues[chatId] = {
            messages: [],
            timer: null
        };
    }

    messageQueues[chatId].messages.push(content);
    console.log(`📥 [${chatName}] Message captured. Queue size: ${messageQueues[chatId].messages.length}. Waiting for 6min of silence...`);

    // איפוס הטיימר בכל הודעה חדשה (Debounce)
    if (messageQueues[chatId].timer) clearTimeout(messageQueues[chatId].timer);

    messageQueues[chatId].timer = setTimeout(async () => {
        const aggregatedText = messageQueues[chatId].messages.join('\n');
        delete messageQueues[chatId]; // ניקוי התור לפני העיבוד

        await processTask(aggregatedText, chatName, msg);
    }, DEBOUNCE_TIME);
});

async function processTask(fullText, chatName, originalMsg) {
    try {
        console.log(`🤖 Analyzing aggregated content from "${chatName}" (Total text length: ${fullText.length})...`);

        const prompt = `You are an educational assistant. Analyze the following WhatsApp messages from a school group named "${chatName}".
                        Context: Use the group name to infer the subject if it's not explicitly mentioned in the text.
                        Content: "${fullText}"
                        
                        If these messages describe a school task, homework, or test, extract the details into this JSON format:
                        {"is_homework": true, "subject": "the subject in Hebrew", "task": "short task description in Hebrew", "due_date": "YYYY-MM-DD or null if not mentioned"}.
                        If it is NOT a task, return: {"is_homework": false}.
                        Return ONLY the raw JSON string.`;

        const result = await model.generateContent(prompt);
        const response = await result.response;
        let responseText = response.text().trim().replace(/^```json\s*/i, "").replace(/\s*```$/, "").trim();
        
        const data = JSON.parse(responseText);

        if (data.is_homework) {
            console.log(`📝 Task identified in ${chatName}:`, data.task);
            
            await notion.pages.create({
                parent: { database_id: process.env.DATABASE_ID },
                properties: {
                    'Task': { title: [{ text: { content: data.task } }] },
                    'Subject': { select: { name: data.subject || chatName } },
                    'Due Date': data.due_date ? { date: { start: data.due_date } } : undefined,
                    'Source': { select: { name: 'WhatsApp' } }
                }
            });

            console.log('✅ Notion updated successfully.');
        } else {
            console.log(`ℹ️ No task found in aggregated messages from ${chatName}.`);
        }
    } catch (err) {
        console.error('❌ Error during processing:', err.message);
    }
}

whatsapp.initialize();