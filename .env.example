# Example environment variables for local development with docker-compose.
# Copy this file to .env and fill in your actual values.

# --- Listener ---
# The BOT_MODE should be 'listener' for local testing of the listener.
BOT_MODE=listener
AUTHORIZED_GROUPS=YOUR_WHATSAPP_GROUP_ID@g.us

# --- Shared Secrets ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
NOTION_TOKEN=YOUR_NOTION_TOKEN
DATABASE_ID=YOUR_NOTION_DATABASE_ID

# --- Mashov (optional — enables school homework polling) ---
MASHOV_USERNAME=YOUR_TEUDAT_ZEHUT
MASHOV_PASSWORD=YOUR_MASHOV_PASSWORD
MASHOV_SCHOOL_SEMEL=YOUR_SCHOOL_ID
MASHOV_YEAR=2025